# Copy to .env; never commit real values.

# xAI API key for novel wish generation (optional — offline fallback when unset)
XAI_API_KEY=

# Grok model name (default: grok-3-mini)
XAI_MODEL=grok-3-mini

# Comma-separated browser origins allowed to call the API (empty = local dev defaults)
MASH_ALLOWED_ORIGINS=

# Per-IP /api/wish calls per hour (default: 120)
MASH_WISH_PER_HOUR=120

# Per-IP LLM escalations per hour (default: 12)
MASH_LLM_PER_HOUR=12

# Total LLM calls per UTC day, all users (default: 500)
MASH_LLM_PER_DAY_GLOBAL=500

# Reject game specs larger than this many bytes (default: 24576)
MASH_MAX_SPEC_BYTES=24576

# HMAC secret for family unlock license tokens (phase 05)
MASH_LICENSE_SECRET=
