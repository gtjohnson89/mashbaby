{
  "id": "babies-eating-cookies",
  "title": "Babies Eating Cookies",
  "brand": "mashbaby",
  "copy": "Mash any key for cookies and ice cream. Babies crawl in and munch them up!",
  "theme": {
    "wallColor": "#1a1218",
    "wallDotColors": ["#ff9ec5", "#c49bff"],
    "floorColor": "#f0c98a",
    "floorLine": "#e0b56e",
    "accent": "#d45a7a",
    "gateBtnFrom": "#e08940",
    "gateBtnTo": "#d45a7a"
  },
  "scene": { "template": "kitchen-mash", "props": {} },
  "onMash": [
