    "persist": true,
    "wallPalette": true,
    "toggles": [
      {
        "id": "dotStyle",
        "label": "✨",
        "corner": "top-left",
        "themeKeys": ["wallDotColors"],
        "options": [
          ["#ff9ec5", "#c49bff"],
          ["#ffe066", "#ff9ec5"],
          ["#7ec8ff", "#c49bff"],
          ["#7bc96f", "#ffe066"]
        ]
      }
    ]
  }
